#!/bin/sh
# Re-runs when the rendered Brewfile content changes.
# Hash: {{ include "Brewfile.tmpl" | sha256sum }}

set -e

if ! command -v brew >/dev/null 2>&1; then
  echo "brew not found — aborting bundle install"
  exit 1
fi

BREWFILE_TMPL="{{ .chezmoi.sourceDir }}/Brewfile.tmpl"
RENDERED=$(mktemp -t Brewfile.XXXXXX)
trap 'rm -f "$RENDERED"' EXIT INT TERM

chezmoi execute-template < "$BREWFILE_TMPL" > "$RENDERED"

echo "==> Running brew bundle install (rendered $BREWFILE_TMPL)"
brew bundle install --file="$RENDERED"
